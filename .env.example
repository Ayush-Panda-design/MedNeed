# ========================================================
# MedNeed - Supabase PostgreSQL & Backend Configuration
# ========================================================

# 1. Supabase PostgreSQL Connection String (Transaction Pooler - Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Supabase Direct Connection String (For Prisma Migrations - Port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 3. Supabase Public Project URL, Anon API Key & Service Role Key (For Private Storage & Prescriptions)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 4. Authentication Secrets & Seeds
JWT_SECRET="generate-a-secure-random-secret-key-at-least-32-characters-long"
INITIAL_ADMIN_PASSWORD="OptionalSecureInitialPassword123"
INITIAL_OWNER_EMAIL="owner@medneed.com"

# 5. Razorpay Gateway Keys (Test or Production Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourKeyHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretHere"

# 6. Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

